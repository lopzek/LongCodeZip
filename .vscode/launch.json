{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File (Fast Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--method",
                "full",
                "--num_examples",
                "1",
                "--gpu_memory_utilization",
                "0.75",
                "--vllm_max_model_len",
                "16384",
                "--max_new_tokens",
                "64",
                "--batch_size",
                "1"
            ]
        },
        {
            "name": "Python Debugger: Current File (Full Eval)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--method",
                "full",
                "--num_examples",
                "2",
                "--gpu_memory_utilization",
                "0.85",
                "--vllm_max_model_len",
                "16384"
            ]
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            //    "args": "${command:pickArgs}",
            //"args": ["--method", "llmlingua"]
            //"args": ["--method", "longllmlingua"]
            "args": [
                "--method",
                "full",
                "--num_examples",
                "2",
                "--gpu_memory_utilization",
                "0.85",
                "--vllm_max_model_len",
                "16384"
            ]
        }
    ]
}